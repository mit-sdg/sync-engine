{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "declaration": true,
    "noEmit": false,
    "outDir": "dist",
    "paths": {
      "@catalog/concepts": ["./packages/catalog/entries/_typecheck/concept-set.ts"],
      "@catalog/registrations": ["./packages/catalog/entries/_typecheck/registrations.ts"],
      "@command/*": ["./src/command/*"],
      "@engine/*": ["./src/engine/*"],
      "@examples/operations-room/*": ["./examples/operations-room/src/*"],
      "@examples/reading-circle/*": ["./examples/reading-circle/src/*"],
      "@examples/*": ["./examples/*"],
      "@mit-sdg/sync-engine/*": ["./src/*/index.ts"],
      "@mit-sdg/sync-engine-http/*": ["./packages/http/src/*/index.ts"],
      "@mit-sdg/sync-engine-analysis/*": ["./packages/analysis/src/*/index.ts"],
      "@root/*": ["./*"],
      "@scripts/*": ["./scripts/*"],
      "@ssf": ["./packages/ssf/dist/index.d.ts"],
      "@sync-engine/*": ["./src/*/index.ts"],
      "@sync-engine/internal/reactions/*": ["./src/engine/reactions/*"],
      "@sync-engine/internal/reads/*": ["./src/engine/reads/*"],
      "@sync-engine/internal/boundary/*": ["./src/engine/boundary/*"],
      "@sync-engine/internal/hosting/*": ["./src/engine/hosting/*"]
    },
    "rewriteRelativeImportExtensions": true,
    "rootDir": "src"
  },
  "include": ["src"],
  "exclude": ["src/command/setup", "tests"]
}
