{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "declaration": true,
    "noEmit": false,
    "outDir": "dist",
    "paths": {
      "@mit-sdg/sync-engine/*": ["../../dist/*/index.d.ts"],
      "@mit-sdg/sync-engine-http/realization": ["../http/dist/realization/index.d.ts"],
      "@mit-sdg/sync-engine-rendering/*": ["../rendering/dist/*/index.d.ts"]
    },
    "rewriteRelativeImportExtensions": true,
    "rootDir": "src"
  },
  "include": ["src"],
  "exclude": ["tests"]
}
