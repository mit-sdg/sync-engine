{
  "schema": 1,
  "id": "concept/gathering",
  "kind": "concept",
  "summary": "Create named gatherings and manage their members.",
  "packages": {
    "@mit-sdg/sync-engine": "1.0.0-beta.8",
    "vite-plus": "^0.2.6"
  },
  "concept": {
