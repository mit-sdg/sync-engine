    {
      "source": "spec.md",
      "target": "$concepts/gathering/spec.md"
    },
    {
      "source": "gathering.conformance.ts",
      "target": "$concepts/gathering/gathering.conformance.ts"
    },
    {
      "source": "gathering.shared.ts",
      "target": "$concepts/gathering/gathering.shared.ts"
    },
    {
