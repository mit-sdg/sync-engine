    }
  ],
  "floors": {
    "memory": {
      "summary": "Process-local state with injectable identity allocation.",
      "files": [
        {
          "source": "gathering.memory.ts",
          "target": "$concepts/gathering/gathering.memory.ts"
        },
        {
          "source": "gathering.memory.test.ts",
          "target": "$concepts/gathering/gathering.memory.test.ts"
        }
      ]
    },
    "mongo": {
      "summary": "MongoDB replica set or sharded deployment using transactions for coherent creation and ordered membership.",
      "packages": {
        "mongodb": "^6.20.0"
      },
      "files": [
        {
          "source": "gathering.mongo.ts",
          "target": "$concepts/gathering/gathering.mongo.ts"
        },
        {
          "source": "gathering.mongo.test.ts",
          "target": "$concepts/gathering/gathering.mongo.test.ts"
        }
