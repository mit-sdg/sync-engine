  "defaultFloor": "memory",
  "files": [
    {
      "source": "spec.md",
      "target": "$concepts/trashing/spec.md"
    },
    {
      "source": "trashing.shared.ts",
      "target": "$concepts/trashing/trashing.shared.ts"
    },
    {
      "source": "trashing.conformance.ts",
      "target": "$concepts/trashing/trashing.conformance.ts"
