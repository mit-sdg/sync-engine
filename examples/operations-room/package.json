{
  "name": "operations-room",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/scenario.ts",
    "test": "LOG_LEVEL=error vp test",
    "typecheck": "tsc --noEmit",
    "artifacts:check": "sync-engine artifacts check --config generated.config.ts",
    "artifacts:pin": "sync-engine artifacts pin --config generated.config.ts",
    "check": "vp check && bun run test && bun run artifacts:check"
  },
  "dependencies": {
    "@mit-sdg/sync-engine": "0.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.2",
    "vite-plus": "0.2.2"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.2"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=20.0.0"
  },
  "packageManager": "bun@1.3.14"
}
