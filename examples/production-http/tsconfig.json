{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node"],
    "paths": {
      "@engine/*": ["../../src/engine/*"],
      "@examples/*": ["../../examples/*"],
      "@mit-sdg/sync-engine/*": ["../../src/*/index.ts"]
    }
  },
  "include": ["src", "tests", "generated.config.ts", "generated", "*.d.ts"]
}
