{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node"],
    "paths": {
      "@design/*": ["./design/*"],
      "@engine/*": ["../../src/engine/*"],
      "@examples/reading-circle/*": ["./src/*"],
      "@mit-sdg/sync-engine/*": ["../../src/*/index.ts"]
    }
  },
  "include": [
    "design",
    "src",
    "tests",
    "generated.config.ts",
    "generated",
    "*.d.ts",
    "vite.config.ts"
  ]
}
