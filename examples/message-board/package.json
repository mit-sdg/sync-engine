{
  "name": "message-board",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/host.ts",
    "start:api": "bun src/api-host.ts",
    "test": "LOG_LEVEL=error vp test",
    "typecheck": "tsc --noEmit",
    "design:check": "sync-engine check --config generated.config.ts",
    "artifacts:check": "sync-engine artifacts check --config generated.config.ts",
    "artifacts:pin": "sync-engine artifacts pin --config generated.config.ts",
    "check": "vp check && bun run design:check && bun run test && bun run artifacts:check"
  },
  "dependencies": {
    "@mit-sdg/sync-engine": "1.2.0",
    "@mit-sdg/sync-engine-http": "1.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.4",
    "@types/node": "^24.0.0",
    "typescript": ">=6 <7",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vite-plus": "1.1.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0"
  },
  "engines": {
    "bun": ">=1.3.4 <2",
    "node": ">=24 <25"
  },
  "packageManager": "bun@1.3.4"
}
